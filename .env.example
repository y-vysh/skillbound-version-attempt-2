# GEMINI_API_KEY: Required if Gemini AI features are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server listening port (must be 3000 in preview)
PORT=3000

# JWT_SECRET: Secret key used to sign JWT authentication tokens
JWT_SECRET="skillbound_dev_jwt_secret_change_in_production"

# SQLITE_DB_PATH: Local database file path
SQLITE_DB_PATH="./data/skillbound.db"
